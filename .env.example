# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Google Drive Sync Configuration (Optional)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_root_folder_id
GOOGLE_DRIVE_TRANSCRIPTS_FOLDER_ID=your_google_drive_transcripts_folder_id
GOOGLE_DRIVE_TRIMMED_AUDIO_FOLDER_ID=your_google_drive_trimmed_audio_folder_id
GOOGLE_DRIVE_LOCAL_PATH=/path/to/GoogleDrive/My Drive/Podcasts

# Google Drive OAuth (if using REST API v3)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Dashboard Configuration
DASHBOARD_PORT=8420
